@ARTICLE{Das20242145,
	author = {Das, Sreeparna and Parihar, Ashish Singh and Chakraborty, Swarnendu Kumar},
	title = {Q-FANETGS-BS: A Six-State Routing Model in FANET for Performing Efficient Data Transfer},
