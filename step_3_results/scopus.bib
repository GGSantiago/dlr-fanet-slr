	note = {Cited by: 5}
}

@ARTICLE{Dhara2026,
	author = {Dhara, Sangita and Malazi, Hadi Tabatabaee and Chaudhry, Saqib Rasool and Kazmi, Aqeel and Clarke, Siobhán},
	title = {Co-Operative Caching for Real-Time Content Retrieval in an Integrated Space-Air-Ground Network for a Post-Disaster Scenario},
	year = {2026},
	journal = {IEEE Transactions on Services Computing},
	pages = {},
	doi = {10.1109/TSC.2026.3667518},
	url = {https://www.scopus.com/pages/publications/105031093637?origin=resultslist},
	abstract = {During environmental disasters, communication infrastructure on the ground may suffer partial damage, resulting in disruptions to critical monitoring and rescue services. To overcome such a challenge, current approaches typically rely on either terrestrial ad hoc networks or satellite and Unmanned Aerial Vehicle (UAV) systems to restore communication services. However, these devices have limited resources, resulting in inefficiencies when analyzing and utilizing various distributed data sources to facilitate post-disaster services. Effective data caching and content retrieval strategies can enhance real-time information access, improving Quality of Service (QoS) for diverse applications. Designing such a system is challenging due to heterogeneous nodes, mobility of data producers and consumers, limited storage capacity, and variable operational needs. This paper proposes an efficient, dynamic, multi-layered content caching and management system based on request forwarding and content retrieval techniques, capable of handling diverse data types using Space, Aerial, and Ground Integrated Networks (SAGIN). The proposed system enhances content availability and reduces retrieval latency by enabling UAVand vehicle-based retrieval, improving QoS. We designed and developed a Contextual Multi-Armed Bandit (MAB) leveraging content freshness, popularity, and size, further extended by a Federated MAB with distributed Q-value sharing. Simulation results show that Contextual MAB outperforms LRU, popularitybased, and even the original MAB by 25-85% across different configurations and settings, while Federated MAB achieves about 15% improvement over Contextual MAB under spatio-temporal dynamics and 8-12% higher hit ratios across vehicle and BS tiers. © 2008-2012 IEEE.},
	author_keywords = {Content caching; disaster management; federated learning; multi-armed bandit; reinforcement learning; resource management; space - air - ground integrated networks (SAGIN)},
	keywords = {Antennas; Digital storage; Disaster prevention; Distributed computer systems; Emergency services; Information management; Machine learning; Natural resources management; Satellite communication systems; Search engines; Telecommunication services; Unmanned aerial vehicles (UAV); Vehicle to vehicle communications; Air grounds; Content caching; Content retrieval; Disaster management; Integrated networks; Multiarmed bandits (MABs); Post disasters; Reinforcement learnings; Resource management; Space - air - ground integrated network; Quality of service},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

