@ARTICLE{Zhou2024399,
	author = {Zhou, Zou and Chen, Longjie and Hu, Yu and Zheng, Fei and Liang, Caisheng and Li, Kelin},
	title = {Q-Learning Based Multi-objective Optimization Routing Strategy in UAVs Deterministic Network},
	year = {2024},
	journal = {Lecture Notes in Electrical Engineering},
	volume = {1126 LNEE},
	pages = {399 - 408},
	doi = {10.1007/978-981-99-9243-0_39},
	url = {https://www.scopus.com/pages/publications/85186639120?origin=resultslist},
	abstract = {In disaster areas, Flying Ad-Hoc Network (FANET) is a critical method for emergency communication. However, the limited payload capacity of Unmanned Aerial Vehicle (UAV) leads to communication link interruption and routing congestion, thus it is a great challenging to the deterministic routing of FANET. This paper proposes a Q-learning based multi-objective optimization routing strategy (QMR) in the UAVs deterministic network. The strategy considers delay, bandwidth and energy as QoS measurement to select a main path. Moreover, the UAV node can sense the energy of next node in the main path. When the energy of next node is low, the current node calculates a disjoint backup path. The simulation results show that compared with the existing routing methods, our strategy can provide higher packet reception rate, lower average end-to-end delay and lower energy consumption. © 2024, The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd.},
