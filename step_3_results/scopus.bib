	title = {Energy-Efficient Narwhal Optimization-based Cooperative Routing Protocol for Stable FANETs (NOA-CRP-SFANET)},
	year = {2025},
	journal = {Proceedings of the 4th International Conference on Intelligent Computing, Information and Control Systems, ICOIICS 2025},
	pages = {845 - 852},
	doi = {10.1109/ICOIICS67115.2025.11390375},
