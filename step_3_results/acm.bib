@inproceedings{10.1145/3804601.3804818,
author = {Zhang, Zhijie and Li, Jiabo and Tian, Yuan},
title = {GSTAM: Task-Aware Mixture of Grouped Experts with Spatial-Temporal Mamba for Cooperative Multi-Vehicle Pursuit},
year = {2026},
isbn = {9798400721717},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3804601.3804818},
doi = {10.1145/3804601.3804818},
abstract = {Urban multi-vehicle pursuit under partial observability demands scalable spatiotemporal reasoning and online multi-target assignment, yet Transformer-based policies scale poorly with team size, and autoregressive Mamba variants can introduce coordination bias via fixed agent ordering. We present GSTAM, a vectorized, parallel policy modeling framework that encodes time dynamics with Temporal Mamba, mixes topology-aware inter-agent context with Spatial Masked-Mean Mamba, and performs implicit, time-varying target allocation using a Task-Aware Mixture of Grouped Experts with load balancing to prevent target collapse. On the benchmark with sparse cooperative rewards requiring at least two pursuers to capture an evader, GSTAM consistently achieves higher team returns across map sizes 13\texttimes{}13 to 17\texttimes{}17 and team scales 4v4 to12v4. Ablations show that removing the MoE module yields the largest degradation, highlighting the central role of task-aware expert specialization in sustained coordination.},
booktitle = {Proceedings of the 5th International Conference on Computer, Artificial Intelligence and Control Engineering},
pages = {1414–1420},
numpages = {7},
keywords = {Mamba, Mixture of Grouped Experts, Multi vehicle pursuit, multi-agent reinforcement learning},
location = {
},
series = {CAICE '26}
}

