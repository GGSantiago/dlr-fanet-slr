@inproceedings{10.1145/3663741.3664786,
author = {Bimonte, Sandro and Bellocchi, Gianni and Pinet, Francois and Charrier, Guillaume and Sacharidis, Dimitris and Sakr, Mahmoud and Tournier, Ronan and Jakllari, Gentian and Chalhoub, Gerard and Kechadi, Tahar and Benatallah, Boualem and Marinello, Francesco and Oberti, Roberto and Bindelle, Jerome and Majore, Ginta and Skrzypczy\'{n}ski, Piotr},
title = {Technological and Research Challenges in Data Engineering for Sustainable Agriculture},
