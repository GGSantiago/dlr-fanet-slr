@ARTICLE{9465215,
  author={Cheng, Hai and Bertizzolo, Lorenzo and D’oro, Salvatore and Buczek, John and Melodia, Tommaso and Bentley, Elizabeth Serena},
  journal={IEEE Open Journal of the Communications Society}, 
  title={Learning to Fly: A Distributed Deep Reinforcement Learning Framework for Software-Defined UAV Network Control}, 
  year={2021},
  volume={2},
  number={},
  pages={1486-1504},
  abstract={Control and performance optimization of wireless networks of Unmanned Aerial Vehicles (UAVs) require scalable approaches that go beyond architectures based on centralized network controllers. At the same time, the performance of model-based optimization approaches is often limited by the accuracy of the approximations and relaxations necessary to solve the UAV network control problem through convex optimization or similar techniques, and by the accuracy of the channel network models used. To address these challenges, this article introduces a new architectural framework to control and optimize UAV networks based on Deep Reinforcement Learning (DRL). Furthermore, it proposes a virtualized, `ready-to-fly' emulation environment to generate the extensive wireless data traces necessary to train DRL algorithms, which are notoriously hard to generate and collect on battery-powered UAV networks. The training environment integrates previously developed wireless protocol stacks for UAVs into the CORE/EMANE emulation tool. Our `ready-to-fly' virtual environment guarantees scalable collection of high-fidelity wireless traces that can be used to train DRL agents. The proposed DRL architecture enables distributed data-driven optimization (with up to 3.7 × throughput improvement and 0.2 × latency reduction in reported experiments), facilitates network reconfiguration, and provides a scalable solution for large UAV networks.},
  keywords={Optimization;Ad hoc networks;Protocols;Drones;Emulation;Wireless sensor networks;Virtual environments;UAV networks;non-terrestrial netoworks;deep reinforcement learning;AI for wireless networks;6G},
  doi={10.1109/OJCOMS.2021.3092690},
  ISSN={2644-125X},
  month={},}@INPROCEEDINGS{10767435,
  author={Chandran, Indu and Vipin, Kizheppatt},
  booktitle={2024 International Conference on Emerging Trends in Networks and Computer Communications (ETNCC)}, 
  title={Multi-Hop Data Offloading in Heterogeneous Ad-Hoc UAV Networks with Deep Reinforcement Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Unmanned Aerial Vehicles (UAVs) have been able to find feasible solutions to many of the challenges faced by various industrial sectors today. Notably, these vehicles often operate as networks, enhancing their capability to execute missions that may be difficult for humans. With the increasing prevalence of UAVs across various sectors, there is an increase in demand for real-time data analysis and decision-making, despite several challenges. Specifically, when deployed in critical missions like disaster response to survey areas and make informed decisions, communication with the base station may be compromised in harsh, dynamic environments. Under such scenarios, there has been a growing recognition of the potential benefits of in-flight data offloading and processing among UAVs where they resort to offloading data to peers with superior computational abilities. This strategy of data offloading can mitigate operation latency, improve efficiency, optimize the utilization of the heterogeneous group by balancing the workload, and enhance resilience to communication disruptions. This paper considers a multi-hop data offloading strategy among UAVs flying in formation. The solution is derived using multi-agent Deep Reinforcement Learning (DRL) framework, which computes the proportion of data each UAV processes based on its computational and battery, and the fraction to be offloaded. A comparison of three DRL algorithms-Actor-Critic, TD-error based and with eligibility traces is presented to solve the offloading problem for a given environment considering various factors, including capacity, task size, residual energy, and the spatial positioning of the nodes.},
  keywords={Surveys;Spread spectrum communication;Autonomous aerial vehicles;Deep reinforcement learning;Ad hoc networks;Real-time systems;Resource management;Vehicle dynamics;Convergence;Resilience;Unmanned aerial network;multi-hop;data-offload;DRL;latency},
  doi={10.1109/ETNCC63262.2024.10767435},
  ISSN={},
  month={July},}@INPROCEEDINGS{9524972,
  author={Wang, Qi and Liu, Jianmin and Liu, Cunzhuang and Huang, Jianhui and He, Chentao and Xu, Yongjun},
  booktitle={2021 IEEE 46th Conference on Local Computer Networks (LCN)}, 
  title={MPRdeep: Multi-Objective Joint Optimal Node Positioning and Resource Allocation for FANETs with Deep Reinforcement learning}, 
  year={2021},
  volume={},
  number={},
  pages={315-318},
  abstract={This paper addresses the problem of UAV positioning and resource allocation under dynamic network conditions and under instantaneous communication demands in FANETs. We propose MPRdeep, an adaptive, deep reinforcement learning (DRL) approach considering several QoS requirements concurrently. MPRdeep learns to optimize relay UAVs’ positions and forwarding probabilities to minimize reliability-achieving delay and reliability-achieving energy consumption. The key advantage is that MPRdeep is able to learn and dynamically adjust the node positioning and resource allocation according to ongoing network conditions. The results show that MPRdeep converges fast and has generalization ability that adapts well under dynamic network conditions and dynamic locations of users. Compared with baseline methods, MPRdeep shows superior performance in terms of lower reliability-achieving delay and lower reliability-achieving energy consumption via simulations and experiments.},
  keywords={Energy consumption;Adaptation models;Computer network reliability;Simulation;Reinforcement learning;Quality of service;Delays;Relay positioning;Resource allocation;Deep Q-Learning Network (DQN);Multi-Objective Optimal;FANETs},
  doi={10.1109/LCN52139.2021.9524972},
  ISSN={0742-1303},
  month={Oct},}@INPROCEEDINGS{11327478,
  author={Mi, Junhui and Qu, Yuben and Zhang, Min and Dong, Chao and Zhang, Lei and Wu, Qihui},
  booktitle={2025 21st International Conference on Mobility, Sensing and Networking (MSN)}, 
  title={DRL-Based Dynamic Multi-Modal Network Handover for Low-Altitude UAVs}, 
  year={2025},
  volume={},
  number={},
  pages={22-29},
  abstract={With the booming low-altitude economy, low-altitude unmanned aerial vehicles (UAVs) are widely used in many industries, fueling surging communication needs. Exploiting existing terrestrial base stations (BSs) solely fail to meet such demands; instead, integrating 5G BSs with other communication systems, such as wireless ad hoc networks, might satisfy the communication demands. To maximize the communication performance of such a multi-modal network for low-altitude UAVs, the handover between the two aforementioned networks is a critical issue. In this paper, we propose a deep reinforcement learning (DRL)-based dynamic handover approach to maximize the quality of service (QoS) of the UAV and minimize the average handover rate simultaneously. Specifically, to address the rapidly varying link quality and network load in low-altitude scenarios, a comprehensive strategy integrates received signal strength (RSS), available bit rate (ABR), round-trip time (RTT), UAV motion states, and network costs in the DRL modeling. Extensive simulations validate the effectiveness of the proposed approach in terms of the QoS and average handover rate, compared to three baselines.},
  keywords={Industries;Dynamics;Quality of service;Handover;Autonomous aerial vehicles;Deep reinforcement learning;Sensors;Vehicle dynamics;Load modeling;Mobile ad hoc networks;Multi-Modal Network;Dynamic handover;Low-Altitude UAVs;Deep Reinforcement Learning;QoS},
  doi={10.1109/MSN69125.2025.00012},
  ISSN={2994-3523},
  month={Dec},}@INPROCEEDINGS{11270493,
  author={Shen, Qiaoqiao and Hu, Bin-Jie},
  booktitle={2025 IEEE 11th World Forum on Internet of Things (WF-IoT)}, 
  title={Blockchain-Enabled Multi-Agent Deep Reinforcement Learning for Task Offloading in UAV-Assisted Vehicular Edge Computing}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={With the development of 6G communication technology, a large number of computation-intensive and latency-sensitive applications have emerged, compelling vehicles to achieve the expected Quality of Service (QoS) through task offloading. Meanwhile, against the backdrop of the growth of the low-altitude economy, Unmanned Aerial Vehicle (UAV)-assisted Vehicular Edge Computing (VEC) has come into being. In this article, we study the task offloading problem in UAV-assisted VEC, where vehicles can choose four modes to process their tasks: local computing, Vehicle-to-Vehicle (V2V) offloading, Vehicle-to-Infrastructure (V2I) offloading and Vehicle-to-UAV (V2U) offloading. We develop a blockchain-based Asynchronous Multi-Agent Reinforcement Learning (AMARL) algorithm to solve the task offloading problem. Asynchronous updates can alleviate the problem of slow aggregation speed in traditional federated learning. The participation of the consortium chain makes the model parameter transmission more secure. Simulation results show that our proposal has achieved an up to 8.6% improvement in offloading efficiency compared to the state-of-the-art schemes.},
  keywords={Federated learning;Vehicle-to-infrastructure;Simulation;Vehicular ad hoc networks;Quality of service;Autonomous aerial vehicles;Proposals;Internet of Things;Relays;Edge computing;UAV;VEC;V2V Offloading;V2I Offloading;V2U Offloading;Reinforcement Learning},
  doi={10.1109/WF-IoT64238.2025.11270493},
  ISSN={2768-1734},
  month={Oct},}@INPROCEEDINGS{9829809,
  author={Grasso, Christian and Raftopoulos, Raoul and Schembra, Giovanni},
  booktitle={2022 IFIP Networking Conference (IFIP Networking)}, 
  title={Tailoring FANET-Based 6G Network Slices in Remote Areas for Low-Latency Applications}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={In the near future, 6G networks will be able to provide its users with heterogeneous tailored end-to-end network services for edge AI-powered applications. However, in many 6G use case scenarios there may not be structured network infrastructures. One solution to meet this problem is to bring computing, networking and storage facilities on site by means of UAVs. The target of this paper is to define a management framework for Flying Ad-Hoc Networks (FANET) aimed at bringing edge computing to remote areas, guaranteeing low latency to ground devices with heterogeneous requirements in terms of mean latency. The proposed framework allows zero-touch management of different network slices realized by partitioning the Computing Elements (CE) installed on each UAV of the FANET and wireless links connecting them to each other. An Inter-Slice Orchestrator is in charge of deciding this resource partition, while an Intra-Slice Orchestrator manages horizontal offload among UAVs for each slice via Reinforcement Learning, in order to minimize the end-to-end latency.},
  keywords={6G mobile communication;Wireless communication;Computational modeling;Reinforcement learning;Probability;Ad hoc networks;Low latency communication;6G;Network Slicing;UAVs;Deep Reinforcement Learning;Low-latency},
  doi={10.23919/IFIPNetworking55013.2022.9829809},
  ISSN={1861-2288},
  month={June},}@INPROCEEDINGS{11390375,
  author={Prasad, D. Hari and Narasimhan, B. and Pradeep, T. and Kumar, S. S. Saravana and Nesakumar, C. Daniel and Praveena, A.},
  booktitle={2025 International Conference on Intelligent Computing, Information and Control Systems (ICOIICS)}, 
  title={Energy-Efficient Narwhal Optimization-Based Cooperative Routing Protocol for Stable FANETs (NOA-CRP-SFANET)}, 
  year={2025},
  volume={},
  number={},
  pages={845-852},
  abstract={Flying Ad Hoc Networks (FANETs) are gradually being deployed for mission-oriented applications and time-critical applications, but their performance is often limited by high communication overhead, limited energy, and dynamic topology. This paper suggests an Energy-Efficient Narwhal OptimizationBased Cooperative Routing Protocol (NOA-CRP-SFANET) to face these challenges. The protocol controls the Narwhal Optimization Algorithm for cluster head selection and cooperative routing, confirming minimal consumption of energy, reduced routing overhead, and enhanced packet delivery. The proposed method is estimated against Multi-Agent Reinforcement Learning (MARL) and Hybrid Deep Reinforcement Learning (HDRL) approaches in simulation scenarios with 50-200 UAVs. Results validate that NOA-CRP-SFANET attains up to $\mathbf{1 5 \%}$ lower energy consumption, reduced latency and higher throughput, maintaining a packet delivery ratio above 96%, indicating greater stability and productivity in dense FANET deployments. NOA-CRP-SFANET is highlighted as a robust solution for energyefficient and reliable UAV network operations.},
  keywords={Energy consumption;Ultra reliable low latency communication;Routing;Throughput;Autonomous aerial vehicles;Deep reinforcement learning;Energy efficiency;Routing protocols;Topology;Optimization;FANETs;UAV Networks;Cooperative Routing;Energy Efficiency;Narwhal Optimization Algorithm;NOA-CRP-SFANET;Multi-Agent Reinforcement Learning;Hybrid Deep Reinforcement Learning;Packet Delivery;Throughput;Latency;Routing Overhead},
  doi={10.1109/ICOIICS67115.2025.11390375},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11377244,
  author={Kumaran, S. and Selvam, B. Arivu and Aiyyasamy, Velu and M, Senthil Murugan and Thendral, N. and Sweetlyne, Annie Blessy},
  booktitle={2025 International Conference on Computing and Communications (COMPUTINGCON)}, 
  title={Secure Military Surveillance Using AI-Enabled Swarm Drones and Blockchain-Backed IoT Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This study introduces a new and unified way to improve military surveillance operations by combining AIenabled swarm drones with blockchain-backed IoT networks. The suggested system uses the intelligence of cooperative drone swarms, each of which can make decisions in real time using deep reinforcement learning, to find, follow, and evaluate any threats on its own in areas where there is competition. A lightweight blockchain protocol is built into the IoT infrastructure to protect data, enable safe communication, and allow drones and ground control to work together without a central point of failure. This also speeds up essential missions by lowering latency. This study is different from other methods that see AI, drones, and blockchain as separate parts. Instead, it presents a complete model that combines them for battlefield surveillance that can be scaled up, is fault-tolerant, and can't be tampered with. The findings of the simulation show that threats can be found with high precision, cyberattacks are less likely to work, and drones can easily sync with each other. This technology is a step ahead in protecting military troops and assets in dynamic, high-risk areas via autonomous, intelligent, and reliable surveillance operations.},
  keywords={Protocols;Satellites;Surveillance;Scalability;Deep reinforcement learning;Real-time systems;Threat assessment;Blockchains;Synchronization;Drones;Autonomous Systems;Real-time Monitoring;Threat Detection;Deep Reinforcement Learning;Distributed Ledger},
  doi={10.1109/COMPUTINGCON64838.2025.11377244},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{9810398,
  author={Galluccio, Laura and Grasso, Christian and Maier, Guido and Raftopoulos, Raoul and Savi, Marco and Schembra, Giovanni and Troia, Sebastian},
  booktitle={2022 20th Mediterranean Communication and Computer Networking Conference (MedComNet)}, 
  title={Reinforcement Learning for Resource Planning in Drone-Based Softwarized Networks}, 
  year={2022},
  volume={},
  number={},
  pages={200-207},
  abstract={In the last few years, some research papers have proposed usage of UAVs organized in Flying Ad-Hoc Network (FANET) in remote areas with a poor or completely non-existent structured network to support novel application scenarios in which data generated by the end users must be processed on site with ultra-low latency. This way, a FANET can be seen as a provider of services and/or slices for extreme-edge 5G networks for delay-sensitive applications. However, keeping a FANET available and active is an ongoing challenge as the autonomy of UAVs is limited and strongly influenced by power consumption of both the engines and the computing element (CE) where the application functions are executed as virtual machines. In this paper, we present an optimization framework capable of increasing the overall duration of the FANET. To this purpose, we apply Reinforcement Learning (RL) based on Double Deep Q-learning (DDQN) to optimize the percentage of available CPU resources for Virtual Function virtualization, and Integer Linear Programming (ILP) to optimize VF placement inside the active UAVs of the FANET.},
  keywords={Q-learning;Power demand;5G mobile communication;Integer linear programming;Virtual machining;Ad hoc networks;Planning;NFV;Virtual Function Placement;FANET;Resource Allocation;Reinforcement Learning.},
  doi={10.1109/MedComNet55087.2022.9810398},
  ISSN={},
  month={June},}@INPROCEEDINGS{10978579,
  author={Qi, Luyu and Wu, Yulei and Dang, Shuping and Simeonidou, Dimitra},
  booktitle={2025 IEEE Wireless Communications and Networking Conference (WCNC)}, 
  title={Optimizing Dynamic Deployment of UAV Base Stations: A Digital Twin Approach}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Unmanned aerial vehicle base station (UAV-BS) communication networks are considered as a promising solution for temporarily recovering urban telecommunication services interrupted by natural disasters. However, the deployment of UAV-BSs remains a challenge in disaster scenarios where terrestrial base stations may be unavailable, and users' locations (mobility in 3D, both on the ground and in the building) and requirements are constantly changing over time. In this paper, we propose a new digital twin (DT) framework to dynamically optimize UAV-BSs deployment in terms of both quantity and location while ensuring guaranteed network quality of service (QoS) and satisfied user requirements. It leverages a graph neural network (GNN) with new random walk for network modeling, a convolutional neural network (CNN) with online learning for QoS prediction, and deep reinforcement learning (DRL) models for optimizing UAV-BSs quantity and location. These three computing paradigms work collaboratively to respond to the evolving disaster context in an adaptive manner, improving UAV-BSs deployment subject to dynamic user requirements and mobility. Simulation results confirm the DT framework's effectiveness in optimizing UAV-BSs deployment in disaster scenarios.},
  keywords={Adaptation models;Base stations;Three-dimensional displays;Disasters;Quality of service;Predictive models;Graph neural networks;Digital twins;Convolutional neural networks;Vehicle dynamics;UAV-BS;telecommunication services recovery;digital twin;graph neural network;reinforcement learning},
  doi={10.1109/WCNC61545.2025.10978579},
  ISSN={1558-2612},
  month={March},}@INPROCEEDINGS{10946660,
  author={Fu, Manyao and Wu, Zhenyu and Xu, Banghao and Ji, Yang},
  booktitle={2024 IEEE 24th International Conference on Communication Technology (ICCT)}, 
  title={Reinforcement Learning-based Scheduling for UAV-assisted Ad-hoc Computing-aware Network}, 
  year={2024},
  volume={},
  number={},
  pages={1214-1218},
  abstract={Edge computing can greatly reduce the high data transmission latency associated with cloud computing, offering user equipment (UE) faster and more efficient computing power. Many studies have explored the use of Unmanned Aerial Vehicles (UAVs) as mobile computing nodes, but these often depend on central nodes like base stations or satellites. To overcome this limitation, we propose a UAV-assisted Ad-hoc Computing-aware Network, where each UAV functions as an independent decision-making node. This network can rapidly establish a reliable communication and computing framework, providing computational support to the area. Given that UAVs within the network can form multi-hop groups and offload computation, we introduce the Network-based Deep Deterministic Policy Gradient (N-DDPG) algorithm. This algorithm optimizes the overall computational capacity of the drone network by considering the perceived network topology. Simulations show that N-DDPG outperforms other methods in reducing both delay and energy consumption in UAV-assisted Ad-hoc Computing-aware Networks.},
  keywords={Energy consumption;Network topology;Heuristic algorithms;Spread spectrum communication;Autonomous aerial vehicles;Ad hoc networks;Delays;Vehicle dynamics;Edge computing;Arithmetic;Unmanned Aerial Vehicle(UAV);deep reinforcement learning;edge computing;multi-hop communication},
  doi={10.1109/ICCT62411.2024.10946660},
  ISSN={2576-7828},
  month={Oct},}@INPROCEEDINGS{11349636,
  author={Andreas, Andreou and Mavromoustakis, Constandinos X. and Mastorakis, George and Bourdena, Athina and Markakis, Evangelos},
  booktitle={2025 IEEE Conference on Network Function Virtualization and Software-Defined Networking (NFV-SDN)}, 
  title={Edge-Assisted Intelligent Routing Framework for Reliable Data Collection in UAV Networks Using Reinforcement Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper proposes an Edge-Assisted Intelligent Routing Framework (EIRF) that integrates Reinforcement Learning (RL) with edge computing, aligning with Software-Defined Networking (SDN) and Network Function Virtualization (NFV) principles for adaptive and resilient UAV communication. The predictive module for mitigating failures utilizes edge resources to predict gateway issues and proactively adjust network paths. Also, the system employs a Deep Reinforcement Learning (DRL) algorithm to dynamically allocate resources and ensure seamless transitions between gateways, maintaining reliable communication under varying network conditions. Extensive simulations demonstrate that EIRF significantly reduces switching latency, improves throughput, and enhances network resilience compared to traditional methods such as Optimized Link State Routing Protocol (OLSR) and batman-adv.},
  keywords={Switches;Logic gates;Routing;Autonomous aerial vehicles;Throughput;Network function virtualization;Reliability;Software defined networking;Virtualization;Edge computing;UAV;Reinforcement Learning;SDN;NFV;Edge Computing;Intelligent Routing;Network Virtualization},
  doi={10.1109/NFV-SDN66355.2025.11349636},
  ISSN={2832-2231},
  month={Nov},}@ARTICLE{10994388,
  author={Zhang, Guobin and Chen, Xuqiang and Han, Guojun and Liu, Chang and Kang, Jiawen},
  journal={IEEE Transactions on Vehicular Technology}, 
  title={Blockchain-Based Distributed Resource Management for Delay Minimization in UAV-Assisted Vehicular Networks}, 
  year={2025},
  volume={74},
  number={10},
  pages={15894-15909},
  abstract={As intelligent transportation system advances, traditional vehicular networks encounter significant challenges of rapidly increasing data amount, stringent latency requirement and severe resource shortage for diversified applications. In this paper, we design a blockchain-based resource management framework to enhance uncrewed aerial vehicle (UAV) aided communications in vehicular networks. The UAVs are divided into primary UAVs (PUs) and secondary UAVs (SUs), and the SUs operate on channels under the tolerated interference limitation (TIL) of the PUs. To coordinate spectrum usage between PUs and SUs, we establish a Stackelberg game model where the PUs adjust the TIL to minimize the overall system delay while each SU selects channel to reduce its own delay under the constraints of transmit power and outage probability. Meanwhile, we employ the blockchain technology to manage the spectrum usage of the SUs under specified TIL configurations. The SUs select their channels and power settings by using deep reinforcement learning (DRL) with the D3QN algorithm, while the advanced Ripple protocol facilitates a low-latency and accurate consensus process among the PUs. Simulation results demonstrate the performance gains of the blockchain technology and DRL algorithm in terms of transmission delay and data rate.},
  keywords={Blockchains;Resource management;Protocols;Games;Delays;Wireless communication;Autonomous aerial vehicles;Reliability;Real-time systems;Interference;Internet of Vehicles;uncrewed aerial vehicle, spectrum allocation;power control;blockchain;deep reinforcement learning (DRL)},
  doi={10.1109/TVT.2025.3568714},
  ISSN={1939-9359},
  month={Oct},}@INPROCEEDINGS{11308381,
  author={Sakhamuru, Amulya and Vasireddy, Sandeep},
  booktitle={2025 International Conference on Sustainable Communication Networks and Application (ICSCN)}, 
  title={AI-Enabled Cross-Layer QoS Routing Framework for Mission-Critical 5G/6G-Integrated MANETs and UAV Swarms}, 
  year={2025},
  volume={},
  number={},
  pages={787-794},
  abstract={Mobile Ad Hoc Networks (MANETs) are increasingly deployed in mission-critical domains such as UAV swarms, military communication, and disaster recovery. The emergence of 5G and forthcoming 6G networks introduces advanced capabilities including ultra-reliable low latency communication (URLLC) and network slicing. However, the inherent challenges of MANETs dynamic topology, mobility-induced route failures, congestion, and energy constraints limit the effectiveness of traditional routing schemes. The aim is to design an adaptive routing framework that ensures reliability, low latency, and energy efficiency for mission-critical MANETs, while seamlessly integrating 5G/6G features. An AI-enabled cross-layer QoS routing framework (AI-CLA-QR) is proposed. The framework leverages a cross-layer telemetry bus that aggregates metrics including buffer occupancy, delay, link quality, energy, and packet velocity. A reinforcement learning-based agent selects the Best Forwarding Node (BFN) to optimize multi-metric QoS objectives. Service differentiation maps real-time data (RTD) to URLLC slices and non-real-time (NRT) flows to enhance mobile broadband (eMBB) slices. Edge intelligence provides policy feedback to dynamically adjust routing priorities. Simulation results demonstrate that AI-CLA-QR improves throughput by up to 25%, increases packet delivery ratio by 15%, reduces end-to-end delay by 23%, lowers deadline miss ratio by 45%, and achieves 20% energy savings compared to AODV, CLAODV, and QRE2PM baselines. The proposed framework ensures robust, QoS-aware, and energy-efficient routing in 5G/6G-integrated MANETs, making it suitable for UAV swarm coordination and other mission-critical applications.},
  keywords={Cross layer design;Mission critical systems;Quality of service;Ultra reliable low latency communication;Routing;Autonomous aerial vehicles;Ad hoc networks;Energy efficiency;Delays;Mobile computing;Cross-layer routing;MANET;UAV swarms;5G/6G networks;Reinforcement learning;Quality of service (QoS)},
  doi={10.1109/ICSCN67106.2025.11308381},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11342996,
  author={Sun, Xueyu and Shi, Weijia and Zhao, Baokang and Zhou, Huan and Huang, Xuefeng},
  booktitle={2025 IEEE International Conference on Systems, Man, and Cybernetics (SMC)}, 
  title={ROBIN: A Distributed MARL Approach for Dynamic Bandwidth Optimization in Drone Ad-Hoc Networks}, 
  year={2025},
  volume={},
  number={},
  pages={4788-4795},
  abstract={The extensive deployment of drone swarms in emergency response and logistics applications presents stringent requirements for mobile ad-hoc network protocols, particularly due to their large-scale and highly dynamic characteristics. As a widely adopted protocol in industrial applications, BATMAN-ADV (Better Approach To Mobile Ad-Hoc Networking Advanced) employs a fixed-interval transmission mechanism for control packets, which leads to inefficient utilization of bandwidth resources. Therefore, we propose ROBIN, a distributed Multi-Agent Reinforcement Learning(MARL) optimization method. Our approach enables each drone to act as an independent agent, autonomously adjusting the control packet transmission interval and optimizing transmission strategies based on localized network states. The solution maintains the protocol’s inherent millisecond end-to-end latency while establishing a dynamic balance between bandwidth consumption and latency performance. Moreover, our method features extremely low resource consumption, making it suitable for drone with limited resources. Experimental results show that ROBIN reduces control packet overhead by 75.9% across diverse network scales and mobility scenarios, while maintaining only 2.29% CPU utilization and 0.25% memory consumption per node on commercial drones.},
  keywords={Protocols;Spectral efficiency;Memory management;Optimization methods;Bandwidth;Reinforcement learning;Ad hoc networks;Swarm intelligence;Drones;Logistics;Drone Swarms;Mobile Ad-Hoc Networks;Multi-Agent Reinforcement Learning},
  doi={10.1109/SMC58881.2025.11342996},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10437037,
  author={Qi, Xuchen and Li, Jieling and Lv, Zefang and Xiao, Liang},
  booktitle={GLOBECOM 2023 - 2023 IEEE Global Communications Conference}, 
  title={Reinforcement Learning Based Energy-Efficient Routing with Latency Constraints for FANETs}, 
  year={2023},
  volume={},
  number={},
  pages={2638-2643},
  abstract={Reinforcement learning (RL) enables flying ad-hoc networks (FANETs) to choose the next hop unmanned aerial vehicles (UAV s) with shorter routing path, but may raise the retransmission rate and fails to guarantee the quality of service (QoS) under the high mobility and fast fading channels. In this paper, we propose an RL based routing scheme that optimizes both the routing and the power allocation to protect the latency QoS and save routing energy consumption of the FANET. Based on the routing history, the channel conditions, the battery level and the shared knowledge from the neighbors, this scheme formulates the routing policy distribution with safe exploration to select the stable path and thus reduce the retransmission rate. Specifically, the risk value with respect to end-to-end latency constraint is designed to evaluate the routing policy and reduce the exploration probability of the high-latency routing. Based on the distributed value function approach, the learning parameter such as the state value functions shared among neighbors is exploited to accelerate the routing process and enhance the routing stability under the dynamic network topology. Simulation results verify the routing performance gain of our proposed scheme over the benchmark.},
  keywords={Network topology;Quality of service;Reinforcement learning;Power system stability;Routing;Stability analysis;Energy efficiency;Unmanned aerial vehicles;flying ad-hoc networks;routing;reinforcement learning;quality of service},
  doi={10.1109/GLOBECOM54140.2023.10437037},
  ISSN={2576-6813},
  month={Dec},}@INPROCEEDINGS{10351396,
  author={Mutoki, Sabah Mohammed Mlkat al and Mohammed, Aymen and Faisal, Nejood and Alkhayyat, Ahmed and Abbas, Fatima Hashim},
  booktitle={2023 6th International Conference on Engineering Technology and its Applications (IICETA)}, 
  title={Rapid Deployment and QoS Provisioning in Coverage Based Multiple UAV Enabled Emergency Communication Networks}, 
  year={2023},
  volume={},
  number={},
  pages={760-765},
  abstract={Unmanned aerial vehicles (UAVs) is a top most trending technology which consists of mobile base stations and ground users and as well maintain certain special characteristics such as small size, cost effective and highly flexible. Achieving effective performance in UAVs environment becomes a complicated task and as well high coverage and better connectivity is needed among the vehicles hence the network performs the vehicle to vehicle communication and vehicle to UAVs to communication. To achieve effective performance in disaster emergency data transmission in the research Rapid Deployment and QoS Provisioning in Coverage (RDQPC) is proposed which includes convinced process such as UAV network model, UAV Mobility model and UAV Clustering Process. At the initial stage network model is constructed to support disaster-based data transmission. Secondly mobility model is introduced to analyze the data traffic in an effective manner so that the traffic congestion and data overlapping during communication can be avoided. Finally, to control the densely populated area the concept of clustering is built in the UAV environment. Using this process, the overall network QoS is greatly improved. The simulation of the proposed RDQPC-UAVs is performed in NS2 and the parameters which are considered for the process of comparative analysis are packet delivery ratio, computational delay, computational overhead, and network throughput and as well it is compared with the earlier research like CCSD-UAV and ENUAM-UAV. From the results it is proven that the proposed RDQPC-UAVs achieve better overall performance when compared with the earlier approaches.},
  keywords={Mobility models;Quality of service;Autonomous aerial vehicles;Throughput;Minimization;Data models;Delays;Unmanned aerial vehicles (UAVs);Quality of Service (QoS);Mobility model;Clustering Process},
  doi={10.1109/IICETA57613.2023.10351396},
  ISSN={2831-753X},
  month={July},}@ARTICLE{11300954,
  author={Fan, Zhijie and Zhang, Mansi and Cao, Yue and Liu, Zilong and Kaiwartya, Omprakash and Javed, Yasir and Bashir Hussain, Faisal},
  journal={IEEE Transactions on Network Science and Engineering}, 
  title={A Novel UAV-Assisted VANET Routing Protocol for Post-Disaster Emergency Communications}, 
  year={2026},
  volume={13},
  number={},
  pages={4863-4882},
  abstract={After natural disasters, such as earthquakes or tsunamis, terrestrial communication networks often become inoperative due to infrastructure collapse. Simultaneously, damage to roads and transportation systems inevitably isolates different parts of the affected area, making it challenging for emergency vehicles to reach critical locations and deploy mobile Base Stations (BSs). In such scenarios, UnmannedAerial Vehicles (UAVs) serve as a flexible and efficient solution. With the capability to establish temporary communication links, UAVs can provide emergency coverage for ground entities. In this paper, we propose a Dynamic Priority-based UAV-assisted Vehicular Ad-hoc Network (VANET) Routing (DPUVR) protocol for post-disaster message transmission. Specifically, DPUVR is a trajectory-based method for controlling the direction of message forwarding. DPUVR utilizes a multi-attribute decision-making method to adaptively evaluate the message delivery capability of candidate nodes (in this paper, nodes refer to both UAVs and vehicles), taking into account trajectory similarity, surplus energy, link survival time, remaining distance cost and queuing delay. In addition, we propose a dynamic prioritization delivery model. It evaluates the priority of messages in node buffers, selects appropriate candidate nodes and then chooses the best relay for message forwarding to trigger timely and efficient message delivery. Extensive simulation results show that DPUVR significantly outperforms other baseline methods in terms of delivery ratio, overhead, average delivery latency and average buffering time.},
  keywords={Routing;Relays;Delays;Autonomous aerial vehicles;Vehicular ad hoc networks;Routing protocols;Vehicle dynamics;Trajectory;Measurement;MATLAB;Unmanned Aerial Vehicle (UAV);Vehicular Ad-hoc Network (VANET);trajectory;emergency communications},
  doi={10.1109/TNSE.2025.3644432},
